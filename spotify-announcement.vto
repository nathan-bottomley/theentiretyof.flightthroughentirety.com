---
permalink: /spotify-announcement/
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="description" content="{{ spotifyPodcast.episodes[0].title }}">
    <link rel="stylesheet" href="/css/index.css">
    <meta name="color-scheme" content="dark">
    <meta name="generator" content="{{ eleventy.generator }}">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="oklch(0.2 0.06 268.35)">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ spotifyPodcast.episodes[0].title }}">
    <meta property="og:image" content="{{ site.linkLogo }}">
    <link rel="preload" href="/font/ArquitectaBold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/font/BespokeSerif-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/font/BespokeSerif-Italic.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <title>{{ spotifyPodcast.episodes[0].title }} | {{ site.title }}</title>
  </head>
  <body>
    <header class="band">
        <h1><a href="/">The Entirety of<br>Flight Through Entirety</a></h1>
        <p>All of the <em>Flight Through Entirety</em> <em>Doctor Who</em> podcasts, together at last</p>
    </header>
    <main>
      <section class="band">
        <h2>{{ spotifyPodcast.episodes[0].title }}</h2>
        {{ spotifyPodcast.episodes[0]["content:encoded"] |> safe }}
      </section>
    </main>
    <footer class="band">
      <p>
        {{ podcast.copyrightNotice }}.
        Created by <a href="https://gunsandfrocks.com">Nathan Bottomley</a> using <a href="https://11ty.dev">Eleventy</a>.</p>
    </footer>
  </body>
</html>
